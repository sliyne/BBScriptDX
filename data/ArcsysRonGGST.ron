    "648": {
      "name": "FixAndGetVoicePattern",
      "arguments": [
        {
          "Type": "C16BYTE",
          "Name": "name"
        }
      ],
      "desc": "[sound] Determines the randomly decided voice pattern and stores the pattern in VAR_Tmp.\nCalling this function fixes the random value for voice until the action ends and it will not change.\nUse this when you want to fix the random value before voice playback (e.g., during cutscene playback) and change behavior based on the random result.\nCannot get a correct value if not called before voice playback.\nPatterns start from 0, with a being 0.",
      "indent": null
    },
