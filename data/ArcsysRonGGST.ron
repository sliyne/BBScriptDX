  "Instructions": {
    "0": {
      "name": "ActionBegin",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "name"
        }
      ],
      "desc": "Start of an action.\nThe name is specified as an argument.\nThe name can be up to 31 characters.\nMust be closed with ActionEnd();",
      "indent": "ScopeBegin"
    },
    "1": {
      "name": "ActionEnd",
      "arguments": [],
      "desc": "End of an action.",
      "indent": "ScopeEnd"
    },
    "2": {
      "name": "CellBegin",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "name"
        },
        {
          "Type": "S32",
          "Name": "time"
        }
      ],
      "desc": "Specifies the Jon file and frame.\nWhen the drawing switches with this command,\nall commands up to the next CellBegin are called.\nExample usage:\tCellBegin(\"no000_00\", 3);\n\t\t\tno000_00 will be played for 3 frames.",
      "indent": "Cell"
    },
    "3": {
      "name": "CellEnd",
      "arguments": [],
      "desc": "Explicitly indicates the end of the CellBegin group.\nMay be used for loop control, etc.",
      "indent": null
    },
    "4": {
      "name": "IfBegin",
      "arguments": [
        {
          "Type": "COperand",
          "Name": "elm"
        }
      ],
      "desc": "Start of conditional branching.",
      "indent": "Begin"
    },
    "5": {
      "name": "IfEnd",
      "arguments": [],
      "desc": "Closes IfBegin.",
      "indent": "End"
    },
    "6": {
      "name": "IfBeginOP2",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "Outputs the result of Op2 and directly confirms if the condition is met (VAR_Tmp will fluctuate)\nOp2( OP2_Eq, VAR_ActReg0, 0 );\nIfBegin( VAR_Tmp );\ncan be done with one line of IfBeginOP2( OP2_Eq, VAR_ActReg0, 0 );",
      "indent": "Begin"
    },
    "7": {
      "name": "IfBeginNot",
      "arguments": [
        {
          "Type": "COperand",
          "Name": "elm"
        }
      ],
      "desc": "Start of conditional branching.",
      "indent": "Begin"
    },
    "8": {
      "name": "IfBeginEnemyName",
      "arguments": [
        {
          "Type": "C16BYTE",
          "Name": "name"
        }
      ],
      "desc": null,
      "indent": "Begin"
    },
    "9": {
      "name": "ElseBegin",
      "arguments": [],
      "desc": "Start of conditional branching.",
      "indent": "Begin"
    },
    "10": {
      "name": "ElseEnd",
      "arguments": [],
      "desc": "Closes ElseBegin.",
      "indent": "End"
    },
    "11": {
      "name": "Label",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        }
      ],
      "desc": "A label to jump to with Goto.\nSee Goto below for details.",
      "indent": null
    },
    "12": {
      "name": "Goto",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        }
      ],
      "desc": "Jumps to the location set by Label.\n(This command closes CellBegin)",
      "indent": null
    },
    "13": {
      "name": "GotoIfOP2",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        },
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "Outputs the result of Op2 and directly confirms if the condition is met (VAR_Tmp will fluctuate)\nOp2( OP2_Eq, VAR_ActReg0, 0 );\nIfBegin( VAR_Tmp );\ncan be done with one line of IfBeginOP2( OP2_Eq, VAR_ActReg0, 0 );",
      "indent": null
    },
    "14": {
      "name": "ReqGoto",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        }
      ],
      "desc": "Goto request.\nDepending on the timing, it can be immediate or the next frame.",
      "indent": null
    },
    "15": {
      "name": "FuncBegin",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "funcName"
        }
      ],
      "desc": "Declares a function. Must be closed with FuncEnd();",
      "indent": "ScopeBegin"
    },
    "16": {
      "name": "FuncEnd",
      "arguments": [],
      "desc": "Closes the function.",
      "indent": "ScopeEnd"
    },
    "17": {
      "name": "FuncCall",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "funcName"
        }
      ],
      "desc": "Calls the function declared above.",
      "indent": null
    },
    "18": {
      "name": "ReqActionEnd",
      "arguments": [],
      "desc": "Terminates the action, same as ActionEnd().\n(This command closes CellBegin)",
      "indent": null
    },
    "19": {
      "name": "DeleteObject",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "objType",
          "EnumName": "CO_TYPE"
        }
      ],
      "desc": "Kills the object. The argument is CO_TYPE",
      "indent": null
    },
    "20": {
      "name": "Suicide",
      "arguments": [],
      "desc": "Eliminates itself",
      "indent": null
    },
    "21": {
      "name": "InterruptBegin",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        }
      ],
      "desc": "Registers an interrupt process.\nRefer to the ON_XXXX_INTRPT section in obj_ScriptInc.h.\nSee the basic section for details.",
      "indent": "Begin"
    },
    "22": {
      "name": "InterruptEnd",
      "arguments": [],
      "desc": "Indicates the end of the interrupt process.\nSee the basic section for details.",
      "indent": "End"
    },
    "23": {
      "name": "ClearInterrupt",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        }
      ],
      "desc": "Cancels the interrupt process.\nRefer to the ON_XXXX_INTRPT section for the argument.",
      "indent": null
    },
    "24": {
      "name": "GotoIf",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        },
        {
          "Type": "COperand",
          "Name": "opd"
        }
      ],
      "desc": null,
      "indent": null
    },
    "25": {
      "name": "GotoIfNot",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        },
        {
          "Type": "COperand",
          "Name": "opd"
        }
      ],
      "desc": null,
      "indent": null
    },
    "26": {
      "name": "CellTimeOverWrite",
      "arguments": [
        {
          "Type": "S32",
          "Name": "time"
        },
        {
          "Type": "COperand",
          "Name": "opd"
        }
      ],
      "desc": null,
      "indent": null
    },
    "27": {
      "name": "ActionRequest",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        }
      ],
      "desc": "Changes the action.\nCaution: Do not request common actions.\nCommon actions are not intended to be requested from anywhere other than locations determined by the program.",
      "indent": null
    },
    "28": {
      "name": "ActionRequestNotSame",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        }
      ],
      "desc": "Requests only if the current action is different",
      "indent": null
    },
    "29": {
      "name": "ActionRequestOld2New",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "oldAction"
        },
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        }
      ],
      "desc": "Requests if the current action is the same as the first argument",
      "indent": null
    },
    "30": {
      "name": "IfBeginCharaName",
      "arguments": [
        {
          "Type": "C16BYTE",
          "Name": "name"
        }
      ],
      "desc": null,
      "indent": "Begin"
    },
    "31": {
      "name": "GotoForLoop",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "label"
        },
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "For programmers, used for loop control",
      "indent": null
    },
    "32": {
      "name": "DeleteObjectActionName",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        }
      ],
      "desc": "Kills all objects with the specified action name.",
      "indent": null
    },
    "33": {
      "name": "SearchActionName",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        },
        {
          "Type": "Enum",
          "Name": "stackID",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        }
      ],
      "desc": "For programmers\nSearches for objects with the specified action name. Excludes those that are broken. If found, sets VAR_Tmp to true and assigns it to the second argument.\nitr specifies a variable initialized to 0. Specifies which number from the top is desired.",
      "indent": null
    },
    "34": {
      "name": "InterruptAction",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        },
        {
          "Type": "C32BYTE",
          "Name": "actname"
        }
      ],
      "desc": "Action request on interrupt. See ON_XXXX_INTRPT for the first argument.",
      "indent": null
    },
    "35": {
      "name": "InterruptGoto",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        },
        {
          "Type": "C32BYTE",
          "Name": "label"
        }
      ],
      "desc": "Goto on interrupt. See ON_XXXX_INTRPT for the first argument.",
      "indent": null
    },
    "36": {
      "name": "InterruptParam0",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        },
        {
          "Type": "S32",
          "Name": "param"
        }
      ],
      "desc": "Sets the interrupt parameter. See ON_XXXX_INTRPT for the first argument.",
      "indent": null
    },
    "37": {
      "name": "InterruptParam1",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "interruptType",
          "EnumName": "ON_XXXX_INTRPT"
        },
        {
          "Type": "S32",
          "Name": "param"
        }
      ],
      "desc": "See above.",
      "indent": null
    },
    "38": {
      "name": "DeleteObjectActionNameNotSelf",
      "arguments": [
        {
          "Type": "C32BYTE",
          "Name": "actionName"
        }
      ],
      "desc": "Kills all objects with the specified action name (excluding itself).",
      "indent": null
    },
    "39": {
      "name": "IfTiming",
      "arguments": [
        {
          "Type": "COperand",
          "Name": "elm"
        }
      ],
      "desc": "For cutscenes. The usual IfBeginOP2(OP2_Eq, VAR_OnIdlingTime, frame); can be replaced with IfTiming(frame).\nCan only be called within ON_IDLING.",
      "indent": "Begin"
    },
    "40": {
      "name": "ControlObjectEnd",
      "arguments": [],
      "desc": "Ends the operation of external objects. See below.",
      "indent": "End"
    },
    "41": {
      "name": "ControlObject",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "type",
          "EnumName": "CO_TYPE"
        }
      ],
      "desc": "Operates external objects.\nRefer to the CO_TYPE section for arguments.\nExample usage:\n\tCellBegin( \"sl56_04\", 3 );\n\t\tCreateObject(\"HUMMER_OBJ2\", 0);\n\n\t\tControlObject(CO_PREV);\t// Operate the object created immediately before\n\t\t\tSetSpeedX(10000);\n\t\tControlObjectEnd();\n\n\tIn this example, an object named HUMMER_OBJ2 is created, and\nthe speed of that object is manipulated.\nCommands executed here are run after the initialization part (ON_INITIALIZE) of HUMMER_OBJ2 is finished.\n\nPlease write with indentation to make it easy to understand.",
      "indent": "Begin"
    },
    "42": {
      "name": "StackControlObjectEx",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "parent",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "Enum",
          "Name": "stackID",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "Enum",
          "Name": "type",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "Enum",
          "Name": "stackID1",
          "EnumName": "CO_TYPE"
        }
      ],
      "desc": "Stores an object. Detailed version.",
      "indent": null
    },
    "43": {
      "name": "StackControlObject",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "stackID",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "Enum",
          "Name": "type",
          "EnumName": "CO_TYPE"
        }
      ],
      "desc": "Stores an object.\nExample:\tStackControlObject(CO_STACK0, CO_PREV);\n\t\tStores the object created immediately before in STACK0.",
      "indent": null
    },
    "44": {
      "name": "Op1",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP1_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        }
      ],
      "desc": "Operation with one operand. The result is assigned to VAR_Tmp.\nRefer to OP1_Type for operators.",
      "indent": null
    },
    "45": {
      "name": "Op2",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "Operation with two operands. The result is assigned to VAR_Tmp.\nRefer to OP1_Type for operators.",
      "indent": null
    },
    "46": {
      "name": "OpCopy",
      "arguments": [
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "Overwrites the first argument with the second argument.",
      "indent": null
    },
    "47": {
      "name": "CheckEnemyName",
      "arguments": [
        {
          "Type": "C16BYTE",
          "Name": "name"
        }
      ],
      "desc": "Checks the enemy's name and assigns it to VAR_Tmp.",
      "indent": null
    },
    "48": {
      "name": "CheckInputEx",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "inputID",
          "EnumName": "INPUT_ID"
        }
      ],
      "desc": "Checks input and assigns it to VAR_Tmp.",
      "indent": null
    },
    "49": {
      "name": "CheckConditionEx",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "condID",
          "EnumName": "CD_CONDITION"
        }
      ],
      "desc": "Checks condition and assigns it to VAR_Tmp.",
      "indent": null
    },
    "50": {
      "name": "CalcRound",
      "arguments": [
        {
          "Type": "COperand",
          "Name": "elm"
        },
        {
          "Type": "S32",
          "Name": "min"
        },
        {
          "Type": "S32",
          "Name": "max"
        }
      ],
      "desc": "Rounds and assigns to VAR_Tmp.",
      "indent": null
    },
    "51": {
      "name": "CheckActive",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "objType",
          "EnumName": "CO_TYPE"
        }
      ],
      "desc": "Checks if active and assigns to VAR_Tmp.",
      "indent": null
    },
    "52": {
      "name": "Op2To",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        },
        {
          "Type": "COperand",
          "Name": "elm2"
        }
      ],
      "desc": "Performs operation with elm0 and elm1 and assigns the result to elm2. Does not modify VAR_Tmp.",
      "indent": null
    },
    "53": {
      "name": "OpCopyEx",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "objType0",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "Enum",
          "Name": "objType1",
          "EnumName": "CO_TYPE"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
        }
      ],
      "desc": "Copies the value of variable elm1 of objType1 to variable elm0 of objType0.",
      "indent": null
    },
    "54": {
      "name": "Op2Direct",
      "arguments": [
        {
          "Type": "Enum",
          "Name": "op",
          "EnumName": "OP2_Type"
        },
        {
          "Type": "COperand",
          "Name": "elm0"
        },
        {
          "Type": "COperand",
          "Name": "elm1"
