    "594": {
      "name": "SoundOption_VoiceRandomChannel",
      "arguments": [
        {
          "Type": "BOOL",
          "Name": "val"
        }
      ],
      "desc": "Uses random information used for random voice playback from another channel.\n\nSoundOption_VoiceChannel( 1 );\nSoundOption_VoiceRandomChannel( 0 );\nVoice( \"xxx\" );\nUsing it like this will play the voice on channel 1, but use the random rule from channel 0.\nMainly used when -1 is set for random in SetupVoice and you want to use the same random value for channel 0 and 1.",
      "indent": null
    },
    "595": {
      "name": "PriorityVoice",
